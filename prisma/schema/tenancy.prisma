enum MemberRole {
  admin
  member
  view_only
}

enum NotificationSeverity {
  success
  info
  warning
  error
}

enum NotificationEventType {
  scenario_generation_complete
  metric_generation_complete
  run_completed
  monitor_failed
  alert_triggered
  call_import_complete
  job_failed
}

model User {
  id            Int                  @id @default(autoincrement())
  email         String               @unique
  name          String
  passwordHash  String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  sessions      Session[]
  memberships   OrganizationMember[]
  notifications Notification[]
  apiKeys       ApiKey[]
  jobs          BackgroundJob[]
}

model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id        Int                  @id @default(autoincrement())
  name      String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   OrganizationMember[]
  projects  Project[]
  apiKeys   ApiKey[]
}

model OrganizationMember {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         Int
  role           MemberRole   @default(member)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Project {
  id                    Int             @id @default(autoincrement())
  organizationId        Int
  name                  String
  outboundTimeout       Int             @default(300)
  maxCallDuration       Int             @default(600)
  minCallDuration       Int             @default(10)
  useProviderTranscript Boolean         @default(false)
  notifyDailyReport     Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys               ApiKey[]
  notifications         Notification[]
  jobs                  BackgroundJob[]
  files                 StoredFile[]

  @@index([organizationId])
}

model ApiKey {
  id             Int          @id @default(autoincrement())
  organizationId Int
  projectId      Int?
  createdById    Int?
  name           String
  keyPrefix      String
  keyHash        String       @unique
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model Notification {
  id        Int                   @id @default(autoincrement())
  userId    Int
  projectId Int?
  eventType NotificationEventType
  severity  NotificationSeverity  @default(success)
  title     String
  body      String
  deepLink  String?
  readAt    DateTime?
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
