enum Gender {
  male
  female
  neutral
}

enum LiveVoice {
  marin
  quartz
  ripple
  vesper
  willow
  stone
  gleam
  meridian
  bossa
  tempo
  beacon
  delta
  cinder
  nuri
  juni
  flitz
  brise
  sillage
  nira
  harema
  shida
  noeul
}

model Personality {
  id                 Int                  @id @default(autoincrement())
  projectId          Int?
  forkedFromId       Int?
  name               String
  description        String               @default("")
  prompt             String               @default("")
  language           Language
  voice              LiveVoice            @default(marin)
  accent             String?
  gender             Gender               @default(neutral)
  isStarred          Boolean              @default(false)
  enabledByDefault   Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  project            Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  forkedFrom         Personality?         @relation("PersonalityFork", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks              Personality[]        @relation("PersonalityFork")
  defaultForProject  Project?             @relation("ProjectDefaultPersonality")
  projectEnablements ProjectPersonality[]
  agentEnablements   AgentPersonality[]
  evaluators         Evaluator[]
  runs               Run[]
  monitorOverrides   MonitorPersonality[]

  @@index([projectId])
  @@index([language])
}

model ProjectPersonality {
  projectId     Int
  personalityId Int
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personality   Personality @relation(fields: [personalityId], references: [id], onDelete: Cascade)

  @@id([projectId, personalityId])
  @@index([personalityId])
}
