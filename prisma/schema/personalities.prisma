model Personality {
  id                           Int                  @id @default(autoincrement())
  projectId                    Int?
  forkedFromId                 Int?
  name                         String
  description                  String               @default("")
  prompt                       String               @default("")
  language                     Language
  accent                       String?
  gender                       Gender               @default(neutral)
  isStarred                    Boolean              @default(false)
  enabledByDefault             Boolean              @default(true)
  voiceModel                   VoiceModel?
  voiceId                      String?
  voiceVolume                  Float?
  speed                        Float?
  interruptionLevel            InterruptionLevel?
  backgroundNoise              BackgroundNoise      @default(off)
  backgroundNoiseUrl           String?
  backgroundSoundVolumeBase    Float?
  backgroundSoundVolumeReduced Float?
  packetLossPercent            Float?
  jitterPercent                Float?
  latencyPercent               Float?
  idleTimeoutSeconds           Int?
  idleMessageMaxSpokenCount    Int?
  startSpeakingWaitSeconds     Float?
  stopSpeakingNumWords         Int?
  stopSpeakingVoiceSeconds     Float?
  stopSpeakingBackoffSeconds   Float?
  cartesiaVolume               Float?
  cartesiaEmotion              CartesiaEmotion?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  project                      Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  forkedFrom                   Personality?         @relation("PersonalityFork", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks                        Personality[]        @relation("PersonalityFork")
  projectEnablements           ProjectPersonality[]
  agentEnablements             AgentPersonality[]
  evaluators                   Evaluator[]
  runs                         Run[]
  monitorOverrides             MonitorPersonality[]

  @@index([projectId])
  @@index([language])
}

model ProjectPersonality {
  projectId     Int
  personalityId Int
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personality   Personality @relation(fields: [personalityId], references: [id], onDelete: Cascade)

  @@id([projectId, personalityId])
  @@index([personalityId])
}

model ClonedVoice {
  id           String     @id @default(uuid())
  name         String
  sampleFileId String     @unique
  createdAt    DateTime   @default(now())
  sampleFile   StoredFile @relation(fields: [sampleFileId], references: [id], onDelete: Cascade)
}
