enum Gender {
  male
  female
  neutral
}

enum InterruptionLevel {
  off
  low
  medium
  high
}

enum VoiceModel {
  eleven_multilingual_v2
  eleven_turbo_v2_5
  eleven_flash_v2_5
  eleven_v3_conversational
  sonic_3_5                @map("sonic-3.5")
}

