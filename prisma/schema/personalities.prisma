  baby_crying
  keyboard_typing
  coughing
  background_printer
  quiet_room_tone
  air_conditioner
  construction_site
  busy_street_traffic
  airport_boarding
  inside_moving_car
  inside_moving_train
  public_park
  rain_and_thunder
  windy_day
  restaurant_ambience
  shopping_mall
  stadium_crowd
  standard_hiss
  static_radio_noise
  fan_buzz
  low_ship_humming
  two_people_talking
  train_station
  custom_url
}

