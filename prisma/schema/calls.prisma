enum CallProcessingStatus {
  pending
  transcribing
  evaluating
  completed
  failed
}

model CallLog {
  id               Int                   @id @default(autoincrement())
  projectId        Int
  agentId          Int?
  agentVersionId   Int?
  conversationId   Int                   @unique
  externalCallId   String
  customerNumber   String?
  status           CallProcessingStatus  @default(pending)
  evaluationStatus CallEvaluationStatus?
  feedback         String?
  errorMessage     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent            Agent?                @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentVersion     AgentVersion?         @relation(fields: [agentVersionId], references: [id], onDelete: SetNull)
  conversation     Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  shareLinks       ShareLink[]

  @@index([projectId, createdAt])
  @@index([projectId, externalCallId])
  @@index([agentId])
}
