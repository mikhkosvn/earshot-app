enum AlertType {
  normal
  significant_change
  threshold
  insight_new_mode
  insight_uptick
}

enum ChangeDirection {
  both
  increase
  decrease
}

enum ThresholdOperator {
  gt
  lt
  outside
}

model AlertRule {
  id                  Int                @id @default(autoincrement())
  metricId            Int
  name                String
  type                AlertType          @default(normal)
  enabled             Boolean            @default(true)
  filters             Json?
  windowSize          Int?
  stdMultiplier       Float?
  ewmaAlpha           Float?
  direction           ChangeDirection?
  thresholdOperator   ThresholdOperator?
  thresholdValue      Float?
  thresholdUpperValue Float?
  minBreaches         Int?
  minCalls            Int?
  minCount            Int?
  multiplier          Float?
  windowHours         Int?
  baselineHours       Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  metric              Metric             @relation(fields: [metricId], references: [id], onDelete: Cascade)
  triggers            AlertTrigger[]

  @@index([metricId])
}

model AlertTrigger {
  id                 Int               @id @default(autoincrement())
  alertRuleId        Int
  conversationId     Int?
  metricEvaluationId Int?
  failureCategoryId  Int?
  observedValue      Float?
  message            String?
  triggeredAt        DateTime          @default(now())
  alertRule          AlertRule         @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  conversation       Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  metricEvaluation   MetricEvaluation? @relation(fields: [metricEvaluationId], references: [id], onDelete: SetNull)
  failureCategory    FailureCategory?  @relation(fields: [failureCategoryId], references: [id], onDelete: SetNull)

  @@index([alertRuleId, triggeredAt])
  @@index([triggeredAt])
}

enum EvaluationConsumer {
  alerts
  insight_triage
}

model EvaluationCursor {
  consumer         EvaluationConsumer @id
  lastEvaluationId Int                @default(0)
  updatedAt        DateTime           @updatedAt
}

enum ObservabilityNotificationKind {
  no_calls
  frequent_calls
}

model ObservabilityNotificationLog {
  id             Int                           @id @default(autoincrement())
  projectId      Int
  kind           ObservabilityNotificationKind
  customerNumber String?
  callCount      Int                           @default(0)
  sentAt         DateTime                      @default(now())
  project        Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind, sentAt])
}
