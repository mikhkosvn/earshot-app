enum JobKind {
  metric_generation
  metric_pattern_review
  evaluator_generation
  evaluator_assistant
  test_call
  reevaluation
  export
  metric_optimization
  insight_generation
  call_import
}

enum JobStatus {
  queued
  running
  completed
  failed
}

model BackgroundJob {
  id          String    @id @default(uuid())
  projectId   Int
  createdById Int?
  kind        JobKind
  status      JobStatus @default(queued)
  currentStep String?
  input       Json
  result      Json?
  error       String?
  dismissedAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, kind, createdAt])
  @@index([status])
}

model StoredFile {
  id          String   @id @default(uuid())
  projectId   Int
  storageKey  String   @unique
  fileName    String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
