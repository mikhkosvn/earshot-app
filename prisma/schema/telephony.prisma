enum PhoneNumberProvider {
  twilio
  telnyx
  plivo
}

model TelephonyPhoneNumber {
  id                 Int                 @id @default(autoincrement())
  organizationId     Int
  provider           PhoneNumberProvider
  phoneNumber        String
  name               String
  accountSid         String?
  authTokenEncrypted String?
  smsEnabled         Boolean             @default(false)
  importedById       Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importedBy         User?               @relation("PhoneNumberImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  evaluators         Evaluator[]

  @@unique([organizationId, phoneNumber])
}
