model Monitor {
  id               Int                  @id @default(autoincrement())
  projectId        Int
  agentId          Int
  name             String
  cronExpression   String
  timezone         Timezone             @default(UTC)
  frequency        Int                  @default(1)
  concurrencyLimit Int?
  callsPerSecond   Float?
  callerNumberMode CallerNumberMode     @default(same_number)
  agentNumber      String?
  notifyOn         NotifyOn             @default(both)
  isActive         Boolean              @default(true)
  nextRunAt        DateTime?
  createdById      Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent            Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy        User?                @relation("MonitorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  evaluators       MonitorEvaluator[]
  personalities    MonitorPersonality[]
  runs             MonitorRun[]

  @@index([projectId])
  @@index([agentId])
  @@index([isActive, nextRunAt])
}

model MonitorEvaluator {
  monitorId   Int
  evaluatorId Int
  monitor     Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  evaluator   Evaluator @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@id([monitorId, evaluatorId])
  @@index([evaluatorId])
}

model MonitorPersonality {
  monitorId     Int
  personalityId Int
  monitor       Monitor     @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  personality   Personality @relation(fields: [personalityId], references: [id], onDelete: Cascade)

  @@id([monitorId, personalityId])
}

model MonitorRun {
  id           Int              @id @default(autoincrement())
  monitorId    Int
  resultId     Int?             @unique
  scheduledFor DateTime
  status       MonitorRunStatus @default(queued)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime         @default(now())
  monitor      Monitor          @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  result       Result?          @relation(fields: [resultId], references: [id], onDelete: SetNull)

  @@unique([monitorId, scheduledFor])
  @@index([status])
}
